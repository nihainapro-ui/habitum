<?xml version="1.0" encoding="utf-8"?>
<!-- Fond de l'icône adaptative (Android 8+).

     `#04060d` est `--bg` du thème `neural`, celui par défaut, et la même
     valeur que `background_color` du manifeste web. Capacitor y laisse du
     BLANC : sur un lanceur sombre, l'icône d'une application dont toute
     l'identité est sombre apparaîtrait alors comme une pastille blanche.

     Généré une fois, à la main — les PNG, eux, viennent de
     `scripts/icones-android.mjs`. -->
<resources>
    <color name="ic_launcher_background">#04060D</color>
</resources>
