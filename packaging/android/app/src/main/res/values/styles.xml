<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème de base. `DayNight` plutôt que `Light` : le cadre natif suit le
         réglage du système au lieu d'imposer un clair sous une application dont
         deux thèmes sur trois sont sombres. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Écran de lancement — API officielle d'Android 12, rétroportée par
         `androidx.core:core-splashscreen`, déjà dans les dépendances.

         Le gabarit de Capacitor pointait ici sur `@drawable/splash`, une image
         à son logo. On lui substitue le fond du produit et son glyphe : un APK
         qui s'ouvre sur la marque de son outil de construction n'est pas fini.

         `postSplashScreenTheme` est ce qui rend la main au thème normal une
         fois le WebView prêt ; sans lui, l'activité garderait le thème de
         lancement pour toute la session. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/habitum_fond</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
