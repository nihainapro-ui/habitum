# ------------------------------------------------------------------
# Habitum — variables d'environnement (modèle)
# Copier en .env.local. Aucun secret ne doit être committé.
#
# Aucune de ces variables n'est requise pour lancer l'application :
# Habitum fonctionne 100 % en local (IndexedDB), sans compte ni serveur.
# Elles ne servent qu'à la phase 6 (synchronisation optionnelle).
# ------------------------------------------------------------------

# URL publique du site (utilisée pour les métadonnées et le manifeste PWA)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 6 : base Postgres Neon (plan gratuit) — OPTIONNEL ---------
# Laisser vide tant que la synchronisation n'est pas activée.
# DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/habitum?sslmode=require"
# DATABASE_URL_UNPOOLED=""

# --- Phase 6 : authentification (Auth.js, gratuit) — OPTIONNEL -------
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"
