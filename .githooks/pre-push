#!/bin/sh
# ---------------------------------------------------------------------------
# Garde-fou de `main`, côté client.
#
# Ce hook est né d'une impossibilité : GitHub refusait la protection de branche
# sur un dépôt PRIVÉ en plan gratuit. Le dépôt est PUBLIC depuis le 25 août
# 2026, et la protection est désormais posée CHEZ GITHUB : `main` y refuse le
# force push et la suppression, où `--no-verify` ne peut rien.
#
# Ce hook garde pourtant tout son sens, parce qu'il fait ce que la protection
# serveur ne fait PAS ici :
#   1. il refuse un push sur `main` si `npm run verify` n'est pas vert. Les
#      contrôles de statut obligatoires ne peuvent pas rendre ce service à un
#      dépôt qui pousse directement sur `main` : ils s'exécutent APRÈS le push
#      qu'ils devraient bloquer ;
#   2. il refuse un push non fast-forward — redondant avec GitHub désormais,
#      mais il échoue en une seconde et en local, au lieu d'un aller-retour.
#
# Sa limite reste la même, et elle est écrite plutôt que sous-entendue : il
# s'exécute chez celui qui pousse, donc `git push --no-verify` le contourne.
# Pour le point 2, GitHub reprend maintenant le relais ; pour le point 1, non.
#
# Installé par `scripts/install-hooks.mjs`, lui-même appelé par `npm install`.
# ---------------------------------------------------------------------------

set -e

BRANCHE_PROTEGEE="refs/heads/main"
ZERO="0000000000000000000000000000000000000000"

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$BRANCHE_PROTEGEE" ] || continue

  # Suppression de la branche distante : jamais.
  if [ "$local_sha" = "$ZERO" ]; then
    echo "pre-push: suppression de main refusée." >&2
    exit 1
  fi

  # Réécriture d'historique : le distant doit être un ancêtre du local.
  if [ "$remote_sha" != "$ZERO" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "pre-push: push non fast-forward sur main refusé (historique linéaire)." >&2
      exit 1
    fi
  fi

  echo "pre-push: vérification complète avant push sur main…"
  if ! npm run verify; then
    echo "" >&2
    echo "pre-push: « npm run verify » a échoué — rien n'est poussé." >&2
    exit 1
  fi
  echo "pre-push: chaîne verte, push autorisé."
done

exit 0
