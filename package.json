{
  "name": "habitum",
  "version": "0.1.0",
  "private": true,
  "description": "Habitum — gestionnaire d'habitudes, tâches, objectifs et temps de focus. Local-first, FR/EN.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:visual": "node scripts/visual.mjs",
    "test:visual:update": "node scripts/visual.mjs --update",
    "check:messages": "node scripts/check-messages.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:messages && npm run check:tokens && npm run check:modernist && npm run check:fonts && npm run check:icons && npm run build && npm run test",
    "check:tokens": "node scripts/extract-tokens.mjs --check",
    "check:icons": "node scripts/generate-icons.mjs --check",
    "icons": "node scripts/generate-icons.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "check:modernist": "node scripts/extract-modernist-tokens.mjs --check",
    "check:fonts": "node scripts/extract-fonts.mjs --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@serwist/next": "^9.5.12",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "lucide-react": "^0.474.0",
    "next": "^15.3.0",
    "next-intl": "^3.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.85.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "_commentaire_overrides": "D11, 25 août 2026 — les quatre vulnérabilités HAUTES n'étaient pas dans `next` mais dans postcss et sharp IMBRIQUÉS sous lui. On les remonte ici plutôt que par next@16, dont la montée a été tentée et annulée le 18 août : elle coûtait le service worker et le budget de polices de la vitrine. sharp n'est de toute façon jamais appelé — `next/image` n'apparaît nulle part. À retirer le jour où next@16 passe, pas avant.",
  "overrides": {
    "postcss": "^8.5.25",
    "nanoid": "^3.3.18",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.2.0",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.3.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-security": "^4.0.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.4.0",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
