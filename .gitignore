# service worker généré par Serwist à chaque build (tâche 5.7). Le SOURCE est
# app/sw.ts ; le fichier compilé n'a pas à être versionné.
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js

# Socle de non-régression visuelle : LINUX uniquement (tâche 8.2).
# Une capture prise sous Windows ou macOS ne se compare à rien — les polices y
# sont différentes. `npm run test:visual` passe par le conteneur officiel pour
# cette raison ; ce qui suit empêche une exécution directe de polluer le socle.
tests/e2e/visual/socle/*-win32.png
tests/e2e/visual/socle/*-darwin.png

# `vercel link` (27 août 2026) a ajouté ici `.vercel` et `.env*`. Les deux sont
# RETIRÉS : `.vercel/` est déjà couvert ligne 31, les fichiers d'environnement
# réels lignes 23-25 — et surtout `.env*` avale `.env.example`, qui est SUIVI et
# qui est le seul endroit où les variables attendues sont documentées.
# La CLI ne réécrira ces lignes qu'au prochain `vercel link` : les revérifier.

# --- Empaquetage Android ---------------------------------------------------
# Le PROJET natif (`packaging/android/`) est SUIVI : c'est du code, il porte le
# nom de paquet, les icônes et le manifeste, et le regénérer à chaque
# construction produirait un APK différent sans qu'on sache pourquoi.
#
# Ce qui suit ne l'est pas : ce sont des sorties, reconstruites par
# `npm run paquet:sync`. `assets/public` en particulier est une COPIE de
# `packaging/www` — la versionner doublerait 4,8 Mo dans l'historique à chaque
# changement d'une seule vue.
/out
/packaging/www
/packaging/android/.gradle
/packaging/android/build
/packaging/android/app/build
/packaging/android/app/src/main/assets/public
/packaging/android/app/src/main/assets/capacitor.config.json
/packaging/android/app/src/main/assets/capacitor.plugins.json
/packaging/android/capacitor-cordova-android-plugins
/packaging/android/local.properties

# Magasin de clés de signature. Il ne DOIT jamais entrer au dépôt : il est le
# seul moyen de publier une mise à jour par-dessus une version installée, et
# quiconque l'obtient peut signer une contrefaçon qu'Android acceptera.
*.keystore
*.jks

# --- Serveur de synchronisation (tâche 6) ----------------------------------
# `wrangler dev` écrit ici l'état local de D1 (une base SQLite) et des
# journaux d'exécution : rien de tout cela ne se partage entre postes, et rien
# ne se déploie — seuls `src/`, `schema.sql` et `wrangler.toml` le sont.
/sync-server/.wrangler/
/sync-server/node_modules/
